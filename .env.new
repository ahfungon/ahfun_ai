# ============================================================
# 基础设施配置（必需）
# 这些配置是应用启动的基础，必须在此文件中配置
# ============================================================

# Database Configuration
DATABASE_URL=postgresql://dual_agent_user:dual_agent_pass@localhost:5432/dual_agent_chat

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_MAX_CONCURRENT_TASKS=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAYS=1,2,4
CLOSING_TIMEOUT=300

# ============================================================
# LLM 配置（可选 - 作为默认值）
# 这些配置已迁移到管理后台的系统配置
# 此处的值仅作为默认值，实际使用时优先从系统配置读取
# 建议：在管理后台配置，此处可以留空或删除
# ============================================================

# DeepSeek API Configuration (默认值)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Summary Configuration (默认值)
SUMMARY_THRESHOLD=8000

# ============================================================
# 配置说明
# ============================================================
# 
# 1. 基础设施配置（DATABASE_URL, REDIS_URL 等）
#    - 必须在此文件中配置
#    - 应用启动时需要
#    - 无法从数据库读取
#
# 2. LLM 配置（DEEPSEEK_API_KEY, SUMMARY_THRESHOLD 等）
#    - 已迁移到管理后台的系统配置
#    - 此处的值仅作为默认值
#    - 优先级：系统配置 > .env 文件 > 代码默认值
#    - 建议：在管理后台配置，此处可以留空
#
# 3. 如何配置 LLM
#    - 打开管理后台: http://localhost:8080/admin.html
#    - 点击"系统配置"
#    - 配置 API Key、模型、阈值等
#    - 保存后立即生效
#
# ============================================================
