<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>对话监控 - 双Agent对话平台</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .header {
            background: white;
            padding: 20px 30px;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            color: #333;
            font-size: 24px;
        }

        .header .badge {
            background: #48bb78;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 14px;
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 20px;
        }

        .panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .panel-header {
            padding: 15px 20px;
            background: #f7fafc;
            border-bottom: 1px solid #e2e8f0;
            font-weight: 600;
            color: #2d3748;
        }

        .panel-body {
            padding: 20px;
        }

        .messages-container {
            height: 600px;
            overflow-y: auto;
            padding: 10px;
        }

        .message {
            margin-bottom: 15px;
            padding: 12px;
            border-radius: 8px;
            background: #f7fafc;
        }

        .message-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 12px;
            color: #718096;
        }

        .message-agent {
            font-weight: 600;
            color: #667eea;
        }

        .message-content {
            color: #2d3748;
            line-height: 1.6;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .message.agent-1 {
            background: #ebf4ff;
            border-left: 3px solid #667eea;
        }

        .message.agent-2 {
            background: #f0fff4;
            border-left: 3px solid #48bb78;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #718096;
            font-size: 14px;
        }

        .info-value {
            color: #2d3748;
            font-weight: 500;
            font-size: 14px;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-active {
            background: #c6f6d5;
            color: #22543d;
        }

        .status-closing {
            background: #feebc8;
            color: #7c2d12;
        }

        .status-closed {
            background: #e2e8f0;
            color: #4a5568;
        }

        .summary-box {
            background: #f7fafc;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .summary-title {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 8px;
        }

        .summary-content {
            color: #4a5568;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        .llm-hint {
            background: #fef5e7;
            border-left: 4px solid #f39c12;
            padding: 12px;
            margin-top: 15px;
            border-radius: 4px;
            color: #7c2d12;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #718096;
        }

        .empty-state-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        .auto-refresh {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #718096;
        }

        .refresh-dot {
            width: 8px;
            height: 8px;
            background: #48bb78;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .messages-container::-webkit-scrollbar {
            width: 8px;
        }

        .messages-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .messages-container::-webkit-scrollbar-thumb {
            background: #cbd5e0;
            border-radius: 4px;
        }

        .messages-container::-webkit-scrollbar-thumb:hover {
            background: #a0aec0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 对话监控</h1>
            <div class="auto-refresh">
                <div class="refresh-dot"></div>
                <span>自动刷新中</span>
            </div>
        </div>

        <div class="main-content">
            <div class="panel">
                <div class="panel-header">💬 对话消息</div>
                <div class="messages-container" id="messagesContainer">
                    <div class="empty-state">
                        <div class="empty-state-icon">⏳</div>
                        <div>正在加载...</div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">📋 话题信息</div>
                <div class="panel-body" id="topicInfo">
                    <div class="empty-state">
                        <div class="empty-state-icon">⏳</div>
                        <div>正在加载...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const monitor = {
            apiUrl: 'http://localhost:8000/api',
            currentTopicId: null,
            refreshInterval: null,

            init() {
                this.loadData();
                this.startAutoRefresh();
            },

            async loadData() {
                try {
                    await this.loadTopic();
                    if (this.currentTopicId) {
                        await this.loadMessages();
                    }
                } catch (error) {
                    console.error('加载数据失败:', error);
                }
            },

            async loadTopic() {
                try {
                    const response = await fetch(`${this.apiUrl}/monitor/topic/active`);

                    if (!response.ok) {
                        if (response.status === 404) {
                            document.getElementById('topicInfo').innerHTML = `
                                <div class="empty-state">
                                    <div class="empty-state-icon">📭</div>
                                    <div>暂无活跃话题</div>
                                </div>
                            `;
                            document.getElementById('messagesContainer').innerHTML = `
                                <div class="empty-state">
                                    <div class="empty-state-icon">💭</div>
                                    <div>暂无消息</div>
                                </div>
                            `;
                            this.currentTopicId = null;
                            return;
                        }
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const topic = await response.json();
                    this.currentTopicId = topic.topic_id;
                    this.displayTopic(topic);
                } catch (error) {
                    console.error('加载话题失败:', error);
                    document.getElementById('topicInfo').innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">❌</div>
                            <div>加载失败</div>
                        </div>
                    `;
                }
            },

            displayTopic(topic) {
                const statusClass = {
                    'active': 'status-active',
                    'closing_pending': 'status-closing',
                    'closed': 'status-closed'
                }[topic.status] || 'status-active';

                const statusText = {
                    'active': '进行中',
                    'closing_pending': '待关闭',
                    'closed': '已关闭'
                }[topic.status] || topic.status;

                let html = `
                    <div class="info-row">
                        <div class="info-label">话题标题</div>
                        <div class="info-value">${this.escapeHtml(topic.title || '无标题')}</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">状态</div>
                        <div class="info-value">
                            <span class="status-badge ${statusClass}">${statusText}</span>
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Token 计数</div>
                        <div class="info-value">${topic.token_count_since_summary || 0}</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">LLM 建议</div>
                        <div class="info-value">${topic.llm_suggestion || '无'}</div>
                    </div>
                `;

                if (topic.summary) {
                    html += `
                        <div class="summary-box">
                            <div class="summary-title">📝 话题总结</div>
                            <div class="summary-content">${this.escapeHtml(topic.summary)}</div>
                        </div>
                    `;
                }

                if (topic.llm_hint) {
                    html += `
                        <div class="llm-hint">
                            💡 ${this.escapeHtml(topic.llm_hint)}
                        </div>
                    `;
                }

                document.getElementById('topicInfo').innerHTML = html;
            },

            async loadMessages() {
                if (!this.currentTopicId) return;

                try {
                    const response = await fetch(
                        `${this.apiUrl}/monitor/topic/${this.currentTopicId}/messages?limit=100`
                    );

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const data = await response.json();
                    this.displayMessages(data.messages);
                } catch (error) {
                    console.error('加载消息失败:', error);
                }
            },

            displayMessages(messages) {
                const container = document.getElementById('messagesContainer');
                
                if (!messages || messages.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">💭</div>
                            <div>暂无消息</div>
                        </div>
                    `;
                    return;
                }

                const html = messages.map(msg => {
                    const agentClass = msg.agent_id === 'agent-1' ? 'agent-1' : 'agent-2';
                    const agentName = msg.agent_id === 'agent-1' ? 'Agent 1' : 'Agent 2';
                    const time = new Date(msg.created_at).toLocaleString('zh-CN');
                    
                    return `
                        <div class="message ${agentClass}">
                            <div class="message-header">
                                <span class="message-agent">${agentName}</span>
                                <span class="message-time">${time}</span>
                            </div>
                            <div class="message-content">${this.escapeHtml(msg.content)}</div>
                        </div>
                    `;
                }).join('');

                container.innerHTML = html;
                container.scrollTop = container.scrollHeight;
            },

            escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            },

            startAutoRefresh() {
                this.refreshInterval = setInterval(() => {
                    this.loadData();
                }, 5000); // 每5秒刷新一次
            }
        };

        // 页面加载完成后初始化
        document.addEventListener('DOMContentLoaded', () => {
            monitor.init();
        });
    </script>
</body>
</html>
