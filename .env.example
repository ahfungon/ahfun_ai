# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dual_agent_chat

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM API Configuration
OPENCLAW_API_KEY=your_openclaw_api_key_here
OPENCLAW_API_URL=https://api.openclaw.example.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Summary Configuration
SUMMARY_THRESHOLD=8000
CLOSING_TIMEOUT=300  # 5 minutes in seconds

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAYS=1,2,4  # Exponential backoff in seconds

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_MAX_CONCURRENT_TASKS=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
